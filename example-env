# ==============================================================================
# Estoque Platform - Example Environment Configuration
# Copy this file to .env and replace placeholders with your actual credentials:
#   cp example-env .env
# ==============================================================================

# --- Django Application Settings ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-super-secret-django-key-here
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=api.estoquee.xyz,estoquee.xyz,www.estoquee.xyz,localhost,127.0.0.1,web

# --- Domain & Traefik Routing ---
API_DOMAIN=api.estoquee.xyz

# --- Cross-Origin Resource Sharing (CORS) & CSRF ---
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://estoquee.xyz,https://www.estoquee.xyz,https://api.estoquee.xyz,http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://api.estoquee.xyz,https://estoquee.xyz,https://www.estoquee.xyz

# --- PostgreSQL Database ---
POSTGRES_DB=estoque_db
POSTGRES_USER=estoque_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis & Celery ---
